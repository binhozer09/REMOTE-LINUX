{
  "manifest_version": 3,
  "name": "YouTube Autoplay e Recuperação Automática",
  "version": "1.3.0",
  "description": "Tenta iniciar ou retomar a reprodução e recupera a aba do YouTube mesmo quando o Chromium mostra uma página de erro.",
  "permissions": [
    "alarms",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://*.youtube-nocookie.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["refresh.js"],
      "run_at": "document_idle"
    }
  ]
}